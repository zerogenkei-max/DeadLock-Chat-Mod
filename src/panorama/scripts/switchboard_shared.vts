        var out = clone(defaults);
        Object.keys(defaults).forEach(function (key) {
            var v = input[key];
            if (v === undefined || key === "version") return;
            if (numeric[key]) {
                if (typeof v !== "number" || !isFinite(v)) throw new Error(key + " must be a number.");
                out[key] = Math.round(Math.max(numeric[key][0], Math.min(numeric[key][1], v)));
            } else if (enums[key]) {
