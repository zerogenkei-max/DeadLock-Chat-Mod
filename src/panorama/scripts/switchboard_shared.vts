        });
    }
    var compiled = { key: null, lists: null };
    function matchers(config) {
        var key = config.responseWords + "\n" + config.objectiveWords + "\n" + config.calloutWords;
        if (compiled.key !== key) compiled = { key: key, lists: { response: compileWords(config.responseWords),
