                out[key] = v.toLowerCase();
            }
        });
        return out;
    }
    function preset(id, current) {
        if (!presets[id]) throw new Error("Unknown preset.");
        var next = clone(defaults), keep = current || defaults;
        keptKeys.forEach(function (k) { if (keep[k] !== undefined) next[k] = keep[k]; });
        Object.keys(presets[id].values).forEach(function (k) { next[k] = presets[id].values[k]; });
        next.preset = id;
        return normalize(next);
    }
    // Scripts written without spaces between words (CJK, Thai and similar).
    var unspaced = /[฀-໿က-႟ក-៿぀-ヿ㐀-䶿一-鿿가-힯豈-﫿ｦ-ﾟ]/;
    function clean(value) { return String(value || "").toLowerCase().replace(/<[^>]*>/g, " ").replace(/[^\w\u0080-￿]+/g, " ").trim(); }
    function compileWords(words) {
        return String(words || "").split(",").map(clean).filter(Boolean).map(function (word) {
            // Whole-word matching needs spaces and Latin letters; otherwise match anywhere in the text.
