        next.showSystem = id === "all";
        return next;
    }
    // Visible-for timer: 1 s steps up to 10 s, then 5 s steps up to 120 s.
    function stepFade(value, direction) {
        var v = Math.max(0, Math.min(120, Math.round(Number(value) || 0)));
