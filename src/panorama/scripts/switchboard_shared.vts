        return compiled.lists;
    }
    function matches(plain, list) {
        var padded = " " + plain + " ";
        for (var i = 0; i < list.length; i++) {
            if (list[i].substring ? plain.indexOf(list[i].word) >= 0 : padded.indexOf(list[i].padded) >= 0) return true;
        }
        return false;
    }
    function category(isPing, text, isSystem, config) {
        if (isSystem) return "system";
        if (!isPing) return "text";
        var plain = clean(text), lists = matchers(config);
        if (matches(plain, lists.response)) return "response";
        if (matches(plain, lists.objective)) return "objective";
        if (matches(plain, lists.callout)) return "callout";
        return "ping";
    }
    function allows(kind, config) {
        return { text: config.showText, ping: config.showPings, callout: config.showCallouts,
            response: config.showResponses, objective: config.showObjectives, system: config.showSystem }[kind] !== false;
    }
    function displayName(player, hero, mode) {
        if (!hero || mode === "player") return player;
        return mode === "both" && hero !== player ? hero + " (" + player + ")" : hero;
    }
